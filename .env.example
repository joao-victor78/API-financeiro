# Variáveis do módulo Financeiro (RNF-12: nenhum segredo no código).
# No docker-compose do infra-integrador-2026 estas variáveis já chegam prontas (README do infra,
# "Variáveis dos módulos"). Este arquivo serve para rodar na máquina: copie para .env.

# ---------- Serviço (Contrato §13.3) ----------
SERVER_PORT=8085

# ---------- Banco: dois usuários (Contrato §7.1) ----------
DB_URL=jdbc:postgresql://localhost:5432/erp
# no infra: usr_financeiro (só dados)
DB_APP_USER=financeiro
DB_APP_PASSWORD=financeiro
# no infra: own_financeiro (migrations)
DB_OWNER_USER=financeiro
DB_OWNER_PASSWORD=financeiro
# Fora do infra o schema não existe ainda: deixe o Flyway criá-lo.
DB_CRIAR_SCHEMA=true

# ---------- RabbitMQ (Contrato §9.7) ----------
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
# false: não consome contratos.eventos (útil sem o broker no ar)
RABBITMQ_CONSUMIR=true

# ---------- Token (Contrato §4) ----------
JWKS_URI=http://localhost:8081/api/identity/.well-known/jwks.json
# Só desenvolvimento, sem o identity: valida com a chave pública local gerada por
# "mvn -q compile exec:java@chaves". Deixe vazio para usar o JWKS.
JWT_PUBLIC_KEY_PATH=./keys/auth-public.pem

# ---------- Integrações (Contrato §9.2) ----------
IDENTITY_BASE_URL=http://localhost:8081
CRM_BASE_URL=http://localhost:8082
SVC_CLIENT_ID=financeiro
# Sem segredo, a régua não busca e-mail no CRM (o disparo fica SEM_DESTINATARIO e vai para a timeline)
SVC_CLIENT_SECRET=

# ---------- Provedor de pagamento simulado (RN-19, RN-20) ----------
# Segredo do HMAC-SHA256 que assina o webhook /public/financeiro/webhooks/pagamento
PROVEDOR_WEBHOOK_SEGREDO=troque-este-segredo
WEBHOOK_LIMITE_POR_MINUTO=60
PIX_CHAVE_RECEBEDOR=financeiro@empresa.com.br
PIX_NOME_RECEBEDOR=EMPRESA
PIX_CIDADE_RECEBEDOR=GOIANIA

# ---------- Jobs (recorrência às 6h, atraso e régua às 7h, horário de Brasília) ----------
JOBS_ENABLED=true

# ---------- Log (RNF-10): JSON por padrão; "logstash" ou "gelf" também servem ----------
LOG_FORMATO=ecs
# ---------- V2: juros e multa automáticos (só para tenants que ligarem em Configurações) ----------
JOB_ENCARGOS_CRON=0 45 6 * * *
# ---------- V2: documentos e extratos (§95, §96) ----------
# local (disco, desenvolvimento) ou s3 (AWS S3, MinIO, Wasabi, R2…)
ARMAZENAMENTO_TIPO=local
ARMAZENAMENTO_DIR=./dados/documentos
ARMAZENAMENTO_TAMANHO_MAXIMO_MB=15
S3_BUCKET=financeiro-documentos
S3_REGIAO=us-east-1
# MinIO: http://localhost:9000 e S3_PATH_STYLE=true
S3_ENDPOINT=
S3_CHAVE_ACESSO=
S3_CHAVE_SECRETA=
S3_PATH_STYLE=false
S3_SSE=true
# ---------- V2: cifra dos segredos guardados no banco (AES-256-GCM, §85) ----------
# 32 bytes em Base64: openssl rand -base64 32. Vazio = chave de desenvolvimento (aviso no log; nunca em produção).
FINANCEIRO_CHAVE_CRIPTOGRAFIA=
# ---------- V2: webhooks de saída (§91) ----------
# Só para testes locais: aceitar http:// e endereços de rede interna como destino
WEBHOOKS_SAIDA_PERMITIR_HTTP=false
WEBHOOKS_SAIDA_PERMITIR_REDE_INTERNA=false
# ---------- V2: provedor de pagamento real (§28) ----------
# simulado (padrão) ou asaas. O adaptador Asaas ainda não foi validado no sandbox.
PROVEDOR_PAGAMENTO=simulado
ASAAS_URL=https://api-sandbox.asaas.com/v3
ASAAS_CHAVE_API=
# Token configurado no painel do Asaas; chega no cabeçalho asaas-access-token de /public/financeiro/webhooks/asaas
ASAAS_TOKEN_WEBHOOK=
# ---------- V2: observabilidade (§98) ----------
# /actuator/health, /actuator/prometheus. Porta só da rede interna (não exponha no gateway).
MANAGEMENT_PORT=9085
