# Endereço da API do módulo Financeiro (Java / Spring Boot)
FINANCEIRO_API_URL=http://localhost:3008
# Origens autorizadas a incorporar o frontend em iframe (CSP frame-ancestors)
FRAME_ANCESTORS='self'
# Origem do sistema principal que envia o token por postMessage (vazio = só a própria origem)
NEXT_PUBLIC_ORIGEM_SISTEMA=
# ---- Somente desenvolvimento/apresentação (ignorado com NODE_ENV=production) ----
# Chave privada gerada por "mvn -q compile exec:java@chaves" na API, para simular o módulo de Autenticação
DEV_CHAVE_PRIVADA=../keys/auth-private.pem
# Mesmo segredo do PIX_WEBHOOK_SECRET da API, para simular o banco avisando um Pix pago
DEV_PIX_WEBHOOK_SECRET=troque-este-segredo
